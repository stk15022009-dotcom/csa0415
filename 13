#include <stdio.h>

int main()
{
    int block[10], process[10];
    int b, p, i, j;

    printf("Enter number of memory blocks: ");
    scanf("%d", &b);

    printf("Enter block sizes:\n");
    for(i = 0; i < b; i++)
        scanf("%d", &block[i]);

    printf("Enter number of processes: ");
    scanf("%d", &p);

    printf("Enter process sizes:\n");
    for(i = 0; i < p; i++)
        scanf("%d", &process[i]);

    // First Fit
    printf("\nFirst Fit:\n");
    for(i = 0; i < p; i++)
    {
        for(j = 0; j < b; j++)
        {
            if(block[j] >= process[i])
            {
                printf("P%d -> Block %d\n", i+1, j+1);
                block[j] -= process[i];
                break;
            }
        }
        if(j == b)
            printf("P%d -> Not Allocated\n", i+1);
    }

    return 0;
}
