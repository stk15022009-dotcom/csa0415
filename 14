#include <stdio.h>
#include <string.h>

int main()
{
    char files[10][20], name[20];
    int n, i, choice, found;

    printf("Enter number of files: ");
    scanf("%d", &n);

    printf("Enter file names:\n");
    for(i = 0; i < n; i++)
        scanf("%s", files[i]);

    while(1)
    {
        printf("\n1. Display Files");
        printf("\n2. Search File");
        printf("\n3. Exit");

        printf("\nEnter choice: ");
        scanf("%d", &choice);

        if(choice == 1)
        {
            printf("\nFiles in Directory:\n");
            for(i = 0; i < n; i++)
                printf("%s\n", files[i]);
        }
        else if(choice == 2)
        {
            printf("Enter file name to search: ");
            scanf("%s", name);

            found = 0;

            for(i = 0; i < n; i++)
            {
                if(strcmp(files[i], name) == 0)
                {
                    found = 1;
                    break;
                }
            }

            if(found)
                printf("File Found");
            else
                printf("File Not Found");
        }
        else if(choice == 3)
            break;
        else
            printf("Invalid Choice");
    }

    return 0;
}
