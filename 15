#include <stdio.h>
#include <string.h>

int main()
{
    char dir[10][10][20];
    char user[10][20], name[20];
    int u, n, i, j, choice, found;

    printf("Enter number of users: ");
    scanf("%d", &u);

    for(i = 0; i < u; i++)
    {
        printf("Enter user name: ");
        scanf("%s", user[i]);

        printf("Enter number of files: ");
        scanf("%d", &n);

        for(j = 0; j < n; j++)
        {
            printf("Enter file name: ");
            scanf("%s", dir[i][j]);
        }
    }

    while(1)
    {
        printf("\n1. Display Files");
        printf("\n2. Search File");
        printf("\n3. Exit");
        printf("\nEnter choice: ");
        scanf("%d", &choice);

        if(choice == 1)
        {
            for(i = 0; i < u; i++)
            {
                printf("\nUser: %s\n", user[i]);

                for(j = 0; dir[i][j][0] != '\0'; j++)
                    printf("%s\n", dir[i][j]);
            }
        }
        else if(choice == 2)
        {
            printf("Enter user name: ");
            scanf("%s", name);

            found = 0;

            for(i = 0; i < u; i++)
            {
                if(strcmp(user[i], name) == 0)
                {
                    printf("Enter file name: ");
                    scanf("%s", name);

                    found = 0;

                    for(j = 0; dir[i][j][0] != '\0'; j++)
                    {
                        if(strcmp(dir[i][j], name) == 0)
                        {
                            found = 1;
                            break;
                        }
                    }

                    if(found)
                        printf("File Found");
                    else
                        printf("File Not Found");

                    break;
                }
            }

            if(i == u)
                printf("User Not Found");
        }
        else if(choice == 3)
            break;
        else
            printf("Invalid Choice");
    }

    return 0;
}
