#include <stdio.h>
#include <fcntl.h>
#include <unistd.h>

int main()
{
    int fd1, fd2, n;
    char buffer[100];

    fd1 = open("input.txt", O_RDONLY);

    if(fd1 < 0)
    {
        printf("Source file not found");
        return 1;
    }

    fd2 = open("output.txt", O_WRONLY | O_CREAT | O_TRUNC, 0644);

    if(fd2 < 0)
    {
        printf("Destination file error");
        close(fd1);
        return 1;
    }

    while((n = read(fd1, buffer, sizeof(buffer))) > 0)
    {
        write(fd2, buffer, n);
    }

    printf("File copied successfully");

    close(fd1);
    close(fd2);

    return 0;
}
