#include<stdio.h>
int main()
{
    int b[10],p[10],i,j,n,m,max;
    printf("Enter blocks: ");
    scanf("%d",&n);
    printf("Enter block sizes:\n");
    for(i=0;i<n;i++)
        scanf("%d",&b[i]);

    printf("Enter processes: ");
    scanf("%d",&m);
    printf("Enter process sizes:\n");
    for(i=0;i<m;i++)
        scanf("%d",&p[i]);

    for(i=0;i<m;i++)
    {
        max=-1;
        for(j=0;j<n;j++)
            if(b[j]>=p[i] && b[j]>max)
            {
                max=b[j];
                int pos=j;
            }
        if(max!=-1)
        {
            for(j=0;j<n;j++)
                if(b[j]==max)
                {
                    printf("P%d allocated\n",i+1);
                    b[j]-=p[i];
                    break;
                }
        }
        else
            printf("P%d not allocated\n",i+1);
    }
    return 0;
}
