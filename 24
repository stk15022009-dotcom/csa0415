#include<stdio.h>
#include<stdlib.h>
#include<unistd.h>
#include<fcntl.h>

int main()
{
    int fd;
    char buffer[100];

    fd=open("sample.txt",O_CREAT|O_WRONLY,0644);
    write(fd,"Hello World",11);
    close(fd);

    fd=open("sample.txt",O_RDONLY);
    read(fd,buffer,11);
    buffer[11]='\0';

    printf("File content: %s",buffer);

    close(fd);
    remove("sample.txt");
    return 0;
}
