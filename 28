#include <stdio.h>
#include <string.h>

int main()
{
    FILE *fp;
    char line[100],word[50];

    fp=fopen("input.txt","w");
    fprintf(fp,"Operating System\n");
    fprintf(fp,"Process Management\n");
    fprintf(fp,"Memory Management\n");
    fclose(fp);

    printf("Enter search word: ");
    scanf("%49s",word);

    fp=fopen("input.txt","r");

    while(fgets(line,100,fp))
    {
        if(strstr(line,word))
            printf("%s",line);
    }

    fclose(fp);
    return 0;
}
