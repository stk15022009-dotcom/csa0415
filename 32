#include <stdio.h>
int main()
{
    int p[20],f[10],t[10];
    int n,m,i,j,pos,faults=0,time=0,hit;

    printf("Enter number of pages: ");
    scanf("%d",&n);

    printf("Enter pages:\n");
    for(i=0;i<n;i++)
        scanf("%d",&p[i]);

    printf("Enter frames: ");
    scanf("%d",&m);

    for(i=0;i<m;i++)
    {
        f[i]=-1;
        t[i]=0;
    }

    for(i=0;i<n;i++)
    {
        hit=0;

        for(j=0;j<m;j++)
        {
            if(f[j]==p[i])
            {
                hit=1;
                t[j]=++time;
            }
        }

        if(!hit)
        {
            pos=0;

            for(j=1;j<m;j++)
                if(t[j]<t[pos])
                    pos=j;

            f[pos]=p[i];
            t[pos]=++time;
            faults++;
        }
    }

    printf("Page faults: %d",faults);
    return 0;
}
