#include <stdio.h>
int main()
{
    int b[20],n,i;

    printf("Enter number of blocks: ");
    scanf("%d",&n);

    printf("Enter block numbers:\n");

    for(i=0;i<n;i++)
        scanf("%d",&b[i]);

    printf("Index block:\n");

    for(i=0;i<n;i++)
        printf("%d -> %d\n",i,b[i]);

    return 0;
}
