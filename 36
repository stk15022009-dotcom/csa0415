#include <stdio.h>
int main()
{
    int b[20],n,i;

    printf("Enter number of blocks: ");
    scanf("%d",&n);

    printf("Enter block numbers:\n");

    for(i=0;i<n;i++)
        scanf("%d",&b[i]);

    printf("Linked blocks:\n");

    for(i=0;i<n-1;i++)
        printf("%d -> ",b[i]);

    printf("%d -> NULL",b[n-1]);

    return 0;
}
