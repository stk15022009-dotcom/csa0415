#include <stdio.h>
#include <stdlib.h>

int main()
{
    int r[20],n,head,i,total=0;

    printf("Enter number of requests: ");
    scanf("%d",&n);

    printf("Enter requests:\n");
    for(i=0;i<n;i++)
        scanf("%d",&r[i]);

    printf("Enter head position: ");
    scanf("%d",&head);

    for(i=0;i<n;i++)
    {
        total+=abs(head-r[i]);
        head=r[i];
    }

    printf("Total seek time: %d",total);

    return 0;
}
