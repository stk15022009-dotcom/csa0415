#include <stdio.h>
#include <stdlib.h>

int main()
{
    int r[20],n,head,start,size;
    int i,j,temp,total=0;

    printf("Enter number of requests: ");
    scanf("%d",&n);

    printf("Enter requests:\n");
    for(i=0;i<n;i++)
        scanf("%d",&r[i]);

    printf("Enter head: ");
    scanf("%d",&head);
    start=head;

    printf("Enter disk size: ");
    scanf("%d",&size);

    for(i=0;i<n;i++)
        for(j=i+1;j<n;j++)
            if(r[i]>r[j])
            {
                temp=r[i];
                r[i]=r[j];
                r[j]=temp;
            }

    for(i=0;i<n;i++)
        if(r[i]>=start)
        {
            total+=abs(head-r[i]);
            head=r[i];
        }

    total+=abs(head-(size-1));
    head=size-1;

    for(i=n-1;i>=0;i--)
        if(r[i]<start)
        {
            total+=abs(head-r[i]);
            head=r[i];
        }

    printf("Total seek time: %d",total);

    return 0;
}
