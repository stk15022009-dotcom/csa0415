
#include <stdio.h>

int main()
{
    int n, i, j, temp;
    int bt[20], p[20], wt[20], tat[20];
    int pid[20];

    printf("Enter number of processes: ");
    scanf("%d", &n);

    for(i = 0; i < n; i++)
    {
        pid[i] = i + 1;
        printf("Enter burst time and priority of P%d: ", i + 1);
        scanf("%d %d", &bt[i], &p[i]);
    }

    // Sorting based on priority
    for(i = 0; i < n - 1; i++)
    {
        for(j = i + 1; j < n; j++)
        {
            if(p[i] > p[j])
            {
                temp = p[i];
                p[i] = p[j];
                p[j] = temp;

                temp = bt[i];
                bt[i] = bt[j];
                bt[j] = temp;

                temp = pid[i];
                pid[i] = pid[j];
                pid[j] = temp;
            }
        }
    }

    wt[0] = 0;

    for(i = 1; i < n; i++)
    {
        wt[i] = wt[i-1] + bt[i-1];
    }

    printf("\nProcess\tPriority\tBT\tWT\tTAT");

    for(i = 0; i < n; i++)
    {
        tat[i] = wt[i] + bt[i];

        printf("\nP%d\t%d\t\t%d\t%d\t%d",
        pid[i], p[i], bt[i], wt[i], tat[i]);
    }

    return 0;
}
